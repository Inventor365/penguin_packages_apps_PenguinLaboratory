<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.penguin.laboratory">

    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <!-- DeX's switches are secure settings the framework and SystemUI read -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <!-- The tab bar list offers every launchable app that has shown a bar -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="@string/laboratory_title"
        android:icon="@drawable/ic_laboratory"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true"
        android:forceQueryable="true">

        <!-- Fetch the segmentation model with Play services as soon as we're installed -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name=".glass.LiquidGlassActivity"
            android:exported="false"
            android:label="@string/liquid_glass_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".glass.TabBarAppsActivity"
            android:exported="false"
            android:label="@string/tab_bars_apps_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".styles.StylesActivity"
            android:exported="false"
            android:label="@string/styles_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".experiments.ExperimentsActivity"
            android:exported="false"
            android:label="@string/experiments_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".dex.DexActivity"
            android:exported="false"
            android:label="@string/dex_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".LaboratoryActivity"
            android:exported="true"
            android:label="@string/laboratory_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".edgelighting.EdgeLightingActivity"
            android:exported="true"
            android:label="@string/edge_lighting_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".wonderland.WonderlandActivity"
            android:exported="true"
            android:label="@string/wonderland_title"
            android:theme="@style/Theme.Laboratory" />

        <activity
            android:name=".wonderland.WonderlandEditorActivity"
            android:exported="false"
            android:label="@string/wonderland_title"
            android:theme="@style/Theme.Laboratory"
            android:windowSoftInputMode="adjustResize" />

        <service
            android:name=".wonderland.WonderlandWallpaperService"
            android:exported="true"
            android:label="@string/wonderland_title"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wonderland_wallpaper" />
        </service>

        <!-- Apps' processes report here when the framework finds a bottom bar in them -->
        <receiver
            android:name=".glass.TabBarSeenReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.penguin.laboratory.action.TAB_BAR_SEEN" />
            </intent-filter>
        </receiver>

        <!-- SystemUI reads the edge lighting style and images from here while dozing -->
        <provider
            android:name=".edgelighting.EdgeLightingProvider"
            android:authorities="com.penguin.laboratory.provider"
            android:directBootAware="true"
            android:exported="true"
            android:readPermission="android.permission.STATUS_BAR_SERVICE" />

    </application>
</manifest>
