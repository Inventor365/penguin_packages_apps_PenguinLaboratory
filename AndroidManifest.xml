<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.penguin.edgelighting">

    <application
        android:label="@string/edge_lighting_title"
        android:icon="@drawable/ic_edge_lighting"
        android:allowBackup="false"
        android:defaultToDeviceProtectedStorage="true"
        android:directBootAware="true">

        <!-- Fetch the segmentation model with Play services as soon as we're installed -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment" />

        <activity
            android:name=".EdgeLightingActivity"
            android:exported="true"
            android:label="@string/edge_lighting_title"
            android:theme="@style/Theme.EdgeLighting">
        </activity>

        <!-- SystemUI reads the toggle and the cutout from here while dozing -->
        <provider
            android:name=".EdgeLightingProvider"
            android:authorities="com.penguin.edgelighting.provider"
            android:directBootAware="true"
            android:exported="true"
            android:readPermission="android.permission.STATUS_BAR_SERVICE" />

    </application>
</manifest>
