<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="48dp"
            android:paddingBottom="24dp"
            android:paddingHorizontal="4dp"
            android:text="@string/edge_lighting_title"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="34sp" />

        <Switch
            android:id="@+id/enabled"
            style="@style/Card.Switch"
            android:text="@string/edge_lighting_switch" />

        <TextView
            style="@style/Description"
            android:text="@string/edge_lighting_description" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/preview_background">

            <ImageView
                android:id="@+id/preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="28dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/edge_lighting_preview" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_horizontal"
            android:textAppearance="?android:attr/textAppearanceSmall" />

        <Button
            android:id="@+id/play"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="@string/edge_lighting_play" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_image" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/images"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_color" />

        <LinearLayout
            android:id="@+id/colors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_effect" />

        <RadioGroup
            android:id="@+id/effects"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_size" />

        <SeekBar
            android:id="@+id/size"
            style="@style/Slider"
            android:max="3" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_amount" />

        <SeekBar
            android:id="@+id/amount"
            style="@style/Slider"
            android:max="2" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_duration" />

        <SeekBar
            android:id="@+id/duration"
            style="@style/Slider"
            android:max="2" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_rotation" />

        <SeekBar
            android:id="@+id/rotation"
            style="@style/Slider"
            android:max="2" />

        <Switch
            android:id="@+id/app_icon"
            style="@style/Card.Switch"
            android:layout_marginTop="28dp"
            android:text="@string/edge_lighting_app_icon" />

        <Switch
            android:id="@+id/screen_off_only"
            style="@style/Card.Switch"
            android:layout_marginTop="12dp"
            android:text="@string/edge_lighting_screen_off_only" />

        <TextView
            style="@style/Header"
            android:text="@string/edge_lighting_keywords" />

        <TextView
            style="@style/Description"
            android:layout_marginTop="0dp"
            android:text="@string/edge_lighting_keywords_description" />

        <LinearLayout
            android:id="@+id/keywords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/add_keyword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edge_lighting_add_keyword" />

    </LinearLayout>
</ScrollView>
